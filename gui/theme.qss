/* AutoSlicer Centralized Modern Dark Theme (gui/theme.qss) */

/* === Base Widgets === */
QWidget {
    background-color: #181b20;
    color: #e5e7eb;
    font-family: "Microsoft JhengHei UI", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    outline: none;
}

QMainWindow {
    background-color: #181b20;
}

QDialog {
    background-color: #1b1e24;
}

/* === Sidebar Navigation === */
QFrame#sidebar {
    background-color: #14171c;
    border-right: 1px solid #282d36;
    min-width: 168px;
    max-width: 168px;
}

QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 16px 2px 16px;
    letter-spacing: 0.5px;
}

QLabel#sidebarSubtitle {
    color: #6b7280;
    font-size: 11px;
    padding: 0px 16px 14px 16px;
}

QPushButton.nav-btn, QPushButton[class="nav-btn"], QPushButton#navBtn {
    background-color: transparent;
    color: #9ca3af;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    padding: 11px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.nav-btn:hover, QPushButton[class="nav-btn"]:hover {
    background-color: #1c2027;
    color: #f3f4f6;
}

QPushButton.nav-btn:checked, QPushButton[class="nav-btn"]:checked,
QPushButton.nav-btn[active="true"], QPushButton[class="nav-btn"][active="true"] {
    background-color: #21252b;
    color: #3b82f6;
    border-left: 3px solid #3b82f6;
    font-weight: 600;
}

QPushButton.nav-btn:disabled, QPushButton[class="nav-btn"]:disabled {
    color: #4b5563;
    background-color: transparent;
}

/* === Cards & Panels === */
QFrame.Card, QFrame[class="card"], QFrame#card, QFrame#cardFrame {
    background-color: #21252b;
    border: 1px solid #333842;
    border-radius: 6px;
}

QGroupBox {
    background-color: #21252b;
    border: 1px solid #333842;
    border-radius: 6px;
    margin-top: 14px;
    padding: 16px 14px 14px 14px;
    font-weight: 600;
    color: #d1d5db;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #9ca3af;
    background-color: #21252b;
}

/* === Buttons === */
QPushButton {
    background-color: #282c34;
    color: #e5e7eb;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: normal;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #323842;
    border-color: #4b5263;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #21252b;
    border-color: #3b82f6;
}

QPushButton:disabled {
    background-color: #1a1d22;
    border-color: #282c34;
    color: #4b5563;
}

/* Primary Button */
QPushButton.primary, QPushButton[class="primary"], QPushButton#primaryButton, QPushButton#btnPrimary {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #1d4ed8;
    font-weight: 500;
}

QPushButton.primary:hover, QPushButton[class="primary"]:hover, QPushButton#primaryButton:hover, QPushButton#btnPrimary:hover {
    background-color: #3b82f6;
    border-color: #2563eb;
    color: #ffffff;
}

QPushButton.primary:pressed, QPushButton[class="primary"]:pressed, QPushButton#primaryButton:pressed, QPushButton#btnPrimary:pressed {
    background-color: #1d4ed8;
    border-color: #1e40af;
}

QPushButton.primary:disabled, QPushButton[class="primary"]:disabled, QPushButton#primaryButton:disabled, QPushButton#btnPrimary:disabled {
    background-color: #1e3a5f;
    border-color: #1e3a5f;
    color: #64748b;
}

/* Danger Button */
QPushButton.danger, QPushButton[class="danger"], QPushButton#dangerButton, QPushButton#btnDanger {
    background-color: #991b1b;
    color: #fee2e2;
    border: 1px solid #b91c1c;
    font-weight: 500;
}

QPushButton.danger:hover, QPushButton[class="danger"]:hover, QPushButton#dangerButton:hover, QPushButton#btnDanger:hover {
    background-color: #dc2626;
    border-color: #ef4444;
    color: #ffffff;
}

QPushButton.danger:pressed, QPushButton[class="danger"]:pressed, QPushButton#dangerButton:pressed, QPushButton#btnDanger:pressed {
    background-color: #7f1d1d;
}

QPushButton.danger:disabled, QPushButton[class="danger"]:disabled, QPushButton#dangerButton:disabled, QPushButton#btnDanger:disabled {
    background-color: #3f1a1a;
    border-color: #3f1a1a;
    color: #7f3939;
}

/* Secondary / Subtle Button */
QPushButton.secondary, QPushButton[class="secondary"], QPushButton#secondaryButton {
    background-color: #1e2228;
    border: 1px solid #333842;
    color: #9ca3af;
}

QPushButton.secondary:hover, QPushButton[class="secondary"]:hover, QPushButton#secondaryButton:hover {
    background-color: #282c34;
    color: #f3f4f6;
}

/* Compact Button */
QPushButton.compact, QPushButton[class="compact"] {
    padding: 3px 8px;
    font-size: 12px;
    min-height: 16px;
}

/* Icon / Tool Button */
QToolButton {
    background-color: #282c34;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    padding: 5px;
    color: #e5e7eb;
}

QToolButton:hover {
    background-color: #323842;
    border-color: #4b5263;
}

/* === Inputs & Text Fields === */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1b1e24;
    color: #f3f4f6;
    border: 1px solid #333842;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3b82f6;
    background-color: #1e2229;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #16181d;
    color: #555b66;
    border-color: #282c34;
}

/* === Dropdowns (ComboBox) === */
QComboBox {
    background-color: #1b1e24;
    color: #f3f4f6;
    border: 1px solid #333842;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #4b5263;
}

QComboBox:focus {
    border-color: #3b82f6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2d323b;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9ca3af;
    margin-right: 4px;
}

QComboBox QAbstractItemView {
    background-color: #21252b;
    color: #f3f4f6;
    border: 1px solid #333842;
    border-radius: 4px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

/* === Checkboxes & RadioButtons === */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e5e7eb;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3f4b;
    border-radius: 3px;
    background-color: #1b1e24;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #3b82f6;
    background-color: #212630;
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #2563eb;
    image: none;
}

QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border: 4px solid #1b1e24;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: #4b5563;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #282c34;
    background-color: #16181d;
}

/* === Tables & Headers === */
QTableWidget, QTableView {
    background-color: #21252b;
    alternate-background-color: #1d2127;
    color: #f3f4f6;
    gridline-color: #282d36;
    border: 1px solid #333842;
    border-radius: 6px;
    selection-background-color: #2d3748;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #2d3748;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1a1d23;
    color: #9ca3af;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #282d36;
    border-bottom: 1px solid #333842;
    font-weight: 600;
    font-size: 12px;
}

QHeaderView::section:last {
    border-right: none;
}

/* === Lists === */
QListWidget, QListView {
    background-color: #1b1e24;
    border: 1px solid #333842;
    border-radius: 4px;
    color: #f3f4f6;
    padding: 4px;
}

QListWidget::item, QListView::item {
    padding: 6px 10px;
    border-radius: 4px;
    margin-bottom: 2px;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #252a33;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #2d3748;
    color: #ffffff;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #16181d;
    border: 1px solid #2d323b;
    border-radius: 4px;
    text-align: center;
    color: #f3f4f6;
    font-size: 11px;
    font-weight: 600;
    height: 16px;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 3px;
}

/* === Scroll Bars === */
QScrollBar:vertical {
    background: #15181d;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #333842;
    min-height: 24px;
    border-radius: 5px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background: #4b5263;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #15181d;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #333842;
    min-width: 24px;
    border-radius: 5px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background: #4b5263;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #282d36;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* === Menus === */
QMenu {
    background-color: #21252b;
    color: #f3f4f6;
    border: 1px solid #333842;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #333842;
    margin: 4px 6px;
}

/* === Tooltip === */
QToolTip {
    background-color: #1f232b;
    color: #f3f4f6;
    border: 1px solid #3b82f6;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* === Universal Drag & Drop Zone Widget === */
QFrame#dropZone {
    background-color: #1b1e24;
    border: 2px dashed #3a3f4b;
    border-radius: 8px;
    padding: 16px;
}

QFrame#dropZone:hover, QFrame#dropZone[dragOver="true"] {
    background-color: #202633;
    border: 2px dashed #3b82f6;
}

QLabel#dropZoneTitle {
    color: #e5e7eb;
    font-size: 13px;
    font-weight: 600;
}

QLabel#dropZoneHint {
    color: #6b7280;
    font-size: 11px;
}

/* === Collapsible Section === */
QFrame#collapsibleHeader {
    background-color: #1f2329;
    border: 1px solid #333842;
    border-radius: 4px;
}

QFrame#collapsibleHeader:hover {
    background-color: #262b33;
}

QToolButton#collapsibleToggle {
    background-color: transparent;
    border: none;
    color: #9ca3af;
    font-weight: 600;
    text-align: left;
    padding: 6px 10px;
}

QFrame#collapsibleContent {
    background-color: #1d2127;
    border: 1px solid #282d36;
    border-top: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 12px;
}

/* === Bottom Task Drawer === */
QFrame#queueDrawer {
    background-color: #181b20;
    border-top: 1px solid #2d323b;
}

QFrame#queueStatusBar {
    background-color: #1c2027;
    border-top: 1px solid #2d323b;
    padding: 6px 12px;
    min-height: 32px;
}

QPlainTextEdit#logConsole {
    background-color: #121417;
    color: #d1d5db;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    border: 1px solid #282c34;
    border-radius: 4px;
    padding: 6px;
}

/* === Status Badges === */
QLabel.Badge, QLabel[class="badge"] {
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* 1. 待打軸 (灰藍) */
QLabel.BadgePending, QLabel[class="badge-pending"], QLabel#badgePending {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* 2. 已生 .llc / 待剪輯 (琥珀黃) */
QLabel.BadgeAmber, QLabel[class="badge-amber"], QLabel#badgeAmber {
    background-color: #451a03;
    color: #f59e0b;
    border: 1px solid #78350f;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* 3. 有切片 / 待修 Metadata (橘紅) */
QLabel.BadgeOrange, QLabel[class="badge-orange"], QLabel#badgeOrange {
    background-color: #431407;
    color: #fb923c;
    border: 1px solid #7c2d12;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* 4. 待匯入標註 (藍紫) */
QLabel.BadgePurple, QLabel[class="badge-purple"], QLabel#badgePurple {
    background-color: #2e1065;
    color: #c084fc;
    border: 1px solid #581c87;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* 5. 已完成 (翠綠) */
QLabel.BadgeGreen, QLabel[class="badge-green"], QLabel#badgeGreen {
    background-color: #052e16;
    color: #4ade80;
    border: 1px solid #14532d;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}

/* 額外輔助徽章 */
QLabel.BadgeRed, QLabel[class="badge-red"], QLabel#badgeRed {
    background-color: #450a0a;
    color: #f87171;
    border: 1px solid #7f1d1d;
    border-radius: 3px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}
